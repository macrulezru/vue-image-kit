{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "jsx": "preserve",
    "skipLibCheck": true,
    "isolatedModules": true,
    "paths": {
      "vue-image-kit": ["./src/index.ts"],
      "vue-image-kit/cdn": ["./src/cdn/index.ts"]
    }
  },
  "include": ["src/nuxt/**/*.ts", "src/nuxt/**/*.d.ts", "src/env.d.ts"]
}
